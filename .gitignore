data/
!data/.gitkeep

# Large data and model files, wherever they appear
*.tif
*.tiff
*.npy
*.npz
*.parquet
*.xlsx
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.zip
*.pt
*.pth
*.ckpt

# ----------------------------------------------------------------------
# Credentials and secrets
# ----------------------------------------------------------------------
kaggle.json
.kaggle/
.env
*.env
credentials*.json
service-account*.json

# ----------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
.conda/

# ----------------------------------------------------------------------
# Jupyter
# ----------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

